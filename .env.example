# Copiar a .env y cambiar los valores (no versionar .env)
RABBITMQ_USER=fraud
RABBITMQ_PASSWORD=cambia-esta-clave
POSTGRES_PASSWORD=cambia-esta-clave
# Keys válidas para la API (separadas por coma)
API_KEYS=demo-key,dashboard-key,load-key
DASHBOARD_API_KEY=dashboard-key
LOAD_API_KEY=load-key
RATE_LIMIT_PER_MINUTE=6000
# local = modelo en el contenedor | sagemaker = endpoint desplegado con sagemaker_deploy
SCORER_BACKEND=local
SAGEMAKER_ENDPOINT=pagoseguro-fraud
AWS_REGION=us-east-1
GRAFANA_PASSWORD=admin
